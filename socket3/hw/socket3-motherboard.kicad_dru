(version 1)

# Inside one component's own land pattern the VENDOR's geometry governs, not the
# board's routing clearance: the TPS546B24A (U10) and MSOP-10 lands are drawn
# closer than the netclass clearance, exactly as the vendor patterns require.
# Same rule as socket7; floor 0.1016 mm, only between two pads of one footprint.
(rule "pad to pad inside one footprint"
	(constraint clearance (min 0.1016mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference"))

# >>> generated by gen_kicad_project.py - do not edit inside the markers
# The two sides of this board are not the same board.  The outer layers
# are 1 oz, which PCBWay cannot etch below 5.0 mil, and the signals
# sit INSIDE at 1 oz, which reaches 4 mil.  The project carries a single
# minimum track width and it is the inner one, so without these two rules
# KiCad passes a 4 mil track on F.Cu and only fab-check.py, reading the
# finished gerbers, ever objects - board A once reported FAB OK with 1127
# unetchable outer tracks.  Width only: a clearance rule scoped to the
# outer layers would also govern pad-to-pad inside a vendor land pattern,
# which the hand-written rule above deliberately relaxes.
(rule "minimum track width, outer layers"
	(constraint track_width (min 0.1270mm))
	(layer outer)
	(condition "A.Type == 'Track'"))

(rule "minimum track width, inner layers"
	(constraint track_width (min 0.1016mm))
	(layer inner)
	(condition "A.Type == 'Track'"))
# <<< end generated
